# Runtime database role. Never use the Railway database owner or migrator URL.
DATABASE_URL=postgresql://worklin_retention_runtime:replace-me@postgres.railway.internal:5432/worklin_retention

# Migration credentials belong only on a temporary private migration release.
# Leave both values disabled/absent on the steady-state service.
WORKLIN_RETENTION_RUN_MIGRATIONS=false
# WORKLIN_RETENTION_MIGRATION_DATABASE_URL=postgresql://worklin_retention_migrator:replace-me@postgres.railway.internal:5432/worklin_retention

WORKLIN_RETENTION_HOST=::
WORKLIN_RETENTION_PORT=8080
WORKLIN_RETENTION_DATABASE_TIMEOUT_MS=10000
WORKLIN_RETENTION_MAX_BODY_BYTES=2097152

# Generate three independent secrets. Never reuse values.
# JWT and webhook secrets must each contain at least 32 bytes.
WORKLIN_RETENTION_SERVICE_JWT_SECRET=replace-me
WORKLIN_RETENTION_SERVICE_WEBHOOK_SECRET=replace-me-too
# Exactly 32 random bytes encoded as 64 hexadecimal characters.
WORKLIN_RETENTION_ENCRYPTION_KEY=replace-with-64-hex-characters

WORKLIN_RETENTION_TOKEN_ISSUER=worklin-control-plane
WORKLIN_RETENTION_TOKEN_AUDIENCE=worklin-retention-service

# Global kill switches. Production starts read-only.
WORKLIN_RETENTION_EXTERNAL_WRITES_ENABLED=false
WORKLIN_RETENTION_SEND_ENABLED=false

WORKLIN_RETENTION_JOB_LEASE_SECONDS=120
WORKLIN_RETENTION_MAX_JOB_ATTEMPTS=8

# Map these from a private Railway bucket using variable references.
WORKLIN_RETENTION_BUCKET_ENDPOINT=https://storage.railway.app
WORKLIN_RETENTION_BUCKET_NAME=replace-with-railway-bucket-api-name
WORKLIN_RETENTION_BUCKET_REGION=auto
WORKLIN_RETENTION_BUCKET_ACCESS_KEY_ID=replace-with-bucket-access-key-id
WORKLIN_RETENTION_BUCKET_SECRET_ACCESS_KEY=replace-with-bucket-secret-access-key
WORKLIN_RETENTION_BUCKET_VIRTUAL_HOSTED_STYLE=false

# Cross-service reference only. These are set on the control-plane provisioner
# and injected into each isolated runtime gateway; retention-service does not
# read them directly.
# WORKLIN_RETENTION_ASSISTANT_BRIDGE_ENABLED=true
# WORKLIN_CONTROL_PLANE_INTERNAL_URL=http://control-plane.railway.internal:8082
# WORKLIN_RETENTION_GATEWAY_INGRESS_SECRET=replace-with-independent-32-byte-minimum-secret
# PLATFORM_ORGANIZATION_ID=11111111-1111-4111-8111-111111111111
# WORKLIN_PLATFORM_ASSISTANT_ID=replace-with-platform-assistant-id
