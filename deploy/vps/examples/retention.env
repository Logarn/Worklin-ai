# Private copy only; worklin_retention_runtime role, worklin_retention database.
DATABASE_URL=
# Match these two secrets in control-plane.env; use distinct random values.
WORKLIN_RETENTION_SERVICE_JWT_SECRET=
WORKLIN_RETENTION_SERVICE_WEBHOOK_SECRET=
# Separate 64-hex encryption key; back it up securely outside the checkout.
WORKLIN_RETENTION_ENCRYPTION_KEY=
# Encrypted payloads remain on the dedicated VPS volume selected in Compose.
WORKLIN_RETENTION_PAYLOAD_STORE=filesystem
WORKLIN_RETENTION_PAYLOAD_DIRECTORY=/data/retention-objects
