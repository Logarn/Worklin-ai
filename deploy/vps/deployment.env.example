# Non-secret Compose inputs for an x86-64 host with at least 7 GB detected RAM
# and a 60 GB filesystem. Replace image references with verified exact tags and
# registry digests before provisioning. Actual secrets live outside Git.
WORKLIN_RELEASE=replace-with-git-commit
WORKLIN_SECRETS_DIR=/etc/worklin-vps
API_HOST=api.example.com
POSTGRES_IMAGE=
CADDY_IMAGE=
BROWSER_ALLOWED_ORIGINS=https://example.com
